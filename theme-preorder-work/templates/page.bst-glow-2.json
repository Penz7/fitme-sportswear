{"sections":{"45f4a788-ab62-41c8-a7cb-b6a714470800":{"type":"image-with-text-overlay","blocks":{"richtext_BqBWDW":{"type":"richtext","settings":{"content":"<p>Khi bước vào những tháng cuối năm, <strong>Fitme<\/strong> mang đến một bộ sưu tập mới như lời nhắn gửi nhỏ: <strong>\" Hãy yêu lấy từng khoảnh khắc bạn vận động và chăm sóc bản thân<\/strong>.\"Thiết kế được tạo ra để hòa nhịp cùng từng chuyển động, cho bạn cảm giác thoải mái và tự do vận động mọi bộ môn, từ Gym, Yoga, Pilates, Tennis,... Không cầu kỳ, bộ sưu tập tập trung vào sự tiện dụng và cảm giác dễ chịu, để bạn có thể tự tin là chính mình – dù ở phòng tập hay trong những hoạt động thường ngày.<br\/><br\/><\/p>"}}},"block_order":["richtext_BqBWDW"],"custom_css":[".h1 {font-weight: bold;}"],"settings":{"full_width":true,"allow_transparent_header":false,"enable_parallax":false,"image_size":"md","image":"shopify:\/\/shop_images\/banner_glow_desk_result.webp","mobile_text_position":"place-self-center text-center","desktop_text_position":"sm:place-self-end-center sm:text-center","text_color":"#ffffff","overlay_color":"#000000","overlay_opacity":72}},"main":{"type":"main-page","settings":{"content_width":"100ch"}},"featured_collection_cWx7nV":{"type":"featured-collection","name":"Featured collection","settings":{"collection":"bst-glow","products":[],"full_width":true,"stack_products":true,"show_progress_bar":false,"products_count":50,"products_per_row_mobile":"2","products_per_row_desktop":4,"subheading":"","title":"","content":"","link_url":"","link_text":"","background":"","background_gradient":"","text_color":"","heading_color":"","heading_gradient":"","product_card_background":"","product_card_text_color":""}},"rich_text_RddKTG":{"type":"rich-text","blocks":{"heading_ULLiXr":{"type":"heading","settings":{"text":"CRAFTED BY VIETNAM - DEFINED BY QUALITY","heading_tag":"p","text_color":"","gradient":""}},"subheading_TaA7xd":{"type":"subheading","settings":{"text":"© FITME SPORTSWEAR 2025"}}},"block_order":["h