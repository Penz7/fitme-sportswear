          "type": "liquid",
          "settings": {
            "liquid": "{%- assign promos = shop.metafields.custom.promo_codes.value -%}\n{%- assign member = shop.metafields.custom.member_promo.value -%}\n{%- if request.locale.iso_code == 'vi' or request.locale.iso_code == 'en' and promos != blank and promos.size > 0 -%}\n<style>\n  .fmp{margin:14px 0 4px;font-family:inherit}\n  .fmp__hd{font-size:13px;font-weight:800;color:#141414;margin-bottom:9px}\n  .fmp__row{display:flex;flex-wrap:wrap;gap:9px;align-items:center}\n  .fmp__chip{position:relative;border:1px dashed #e0955a;background:#fff4ec;color:#d9772f;border-radius:8px;padding:7px 13px;font-size:13px;font-weight:700;cursor:pointer;transition:background .15s}\n  .fmp__chip:hover{background:#ffe6d3}\n  .fmp__chip--vip{border-color:#c9a227;background:#fbf6e8;color:#a5811a}\n  .fmp__chip--vip:hover{background:#f5ebcf}\n  .fmp__login{display:inline-flex;align-items:center;gap:7px;background:#141414;color:#fff;border:0;border-radius:8px;padding:9px 15px;font-size:13px;font-weight:700;text-decoration:none;cursor:pointer;transition:opacity .15s}\n  .fmp__login:hover{opacity:.85}\n  .fmp__tip{position:absolute;bottom:calc(100% + 9px);left:50%;transform:translateX(-50%);width:240px;max-width:76vw;background:#141414;color:#fff;border-radius:10px;padding:11px 13px;font-size:12px;font-weight:400;line-height:1.45;text-align:left;opacity:0;visibility:hidden;transition:opacity .15s;z-index:30;box-shadow:0 10px 30px rgba(0,0,0,.28);white-space:normal}\n  .fmp__chip:hover .fmp__tip{opacity:1;visibility:visible}\n  .fmp__tip b{color:#fff;font-weight:800;letter-spacing:.04em}\n  .fmp__tip .fmp__rem{color:#ffb27a;font-weight:600}\n  .fmp__tip::after{content:\"\";position:absolute;top:100%;left:50%;transform:translateX(-50%);border:6px solid transparent;border-top-color:#141414}\n  .fmp__toast{position:fixed;right:18px;bottom:18px;max-width:330px;background:#fff;border:1px solid #e7e2d6;border-left:4px solid #2e7d32;border-radius:12px;padding:12px 15px;box-shadow:0 14px 38px rgba(0,0,0,.20);z-index:99999;transform:translateY(24px);opacity:0;visibility:hidden;transition:transform .25s,opacity .25s;font-family:inherit}\n  .fmp__toast.show{transform:translateY(0);opacity:1;visibility:visible}\n  .fmp__toast b{display:block;font-size:14px;font-weight:800;color:#141414;margin-bottom:3px}\n  .fmp__toast span{font-size:12.5px;color:#6b6b6b;line-height:1.4}\n</style>\n<div class=\"fmp\">\n  <div class=\"fmp__hd\">Mã giảm giá</div>\n  <div class=\"fmp__row\">\n    {%- for pm in promos -%}\n    {%- assign pcode = pm.code.value -%}\n    {%- if pcode != blank -%}\n    <span class=\"fmp__chip\" data-code=\"{{ pcode }}\" data-note=\"{{ pm.note.value | escape }}\" onclick=\"fmSavePromo(this)\">\n      {{ pm.label.value | default: pcode }}\n      <span class=\"fmp__tip\">Nhập <b>{{ pcode }}</b>{%- if pm.remaining.value != blank %} · <span class=\"fmp__rem\">{{ pm.remaining.value }}</span>{% endif -%}{%- if pm.note.value != blank %}<br>{{ pm.note.value }}{% endif -%}</span>\n    </span>\n    {%- endif -%}\n    {%- endfor -%}\n    {%- if member != blank -%}\n      {%- assign mcode = member.code.value -%}\n      {%- if customer -%}\n        {%- if customer.orders_count == 0 and mcode != blank -%}\n        <span class=\"fmp__chip fmp__chip--vip\" data-code=\"{{ mcode }}\" data-note=\"{{ member.note.value | escape }}\" onclick=\"fmSavePromo(this)\">\n          🎁 {{ member.label.value | default: mcode }}\n          <span class=\"fmp__tip\">Nhập <b>{{ mcode }}</b>{%- if member.remaining.value != blank %} · <span class=\"fmp__rem\">{{ member.remaining.value }}</span>{% endif -%}{%- if member.note.value != blank %}<br>{{ member.note.value }}{% endif -%}</span>\n        </span>\n        {%- endif -%}\n      {%- else -%}\n        <a class=\"fmp__login\" href=\"{{ routes.account_login_url }}\">🎁 Đăng nhập nhận mã 100K đơn đầu →</a>\n      {%- endif -%}\n    {%- endif -%}\n  </div>\n</div>\n<div class=\"fmp__toast\" id=\"fmToast\"><b id=\"fmToastCode\"></b><span id=\"fmToastMsg\"></span></div>\n<script>\nfunction fmSavePromo(el){\n  var code=el.getAttribute('data-code'), note=el.getAttribute('data-note')||'';\n  try{ if(navigator.clipboard){ navigator.clipboard.writeText(code); } }catch(e){}\n  var t=document.getElementById('fmToast');\n  document.getElementById('fmToastCode').textContent='Đã lưu mã '+code+' ✓';\n  document.getElementById('fmToastMsg').textContent=(note?note+' — ':'')+'Dán mã vào ô \"Mã giảm giá\" khi thanh toán.';\n  t.classList.add('show');\n  clearTimeout(window.__fmToastT); window.__fmToastT=setTimeout(function(){t.classList.remove('show');},4000);\n}\n</script>\n{%- endif -%}"
          }
        }
      },
