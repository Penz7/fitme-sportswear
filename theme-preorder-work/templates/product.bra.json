ttom:1px solid var(--fm-line)}\n  .fitme-modal__hd h3{margin:0;font-size:16px;letter-spacing:.04em;text-transform:uppercase}\n  .fitme-modal__x{background:none;border:0;font-size:24px;line-height:1;cursor:pointer;color:#666}\n  .fitme-modal__bd{padding:20px 22px}\n  .fitme-modal__bd p{margin:0 0 14px;font-size:13px;color:var(--fm-mut)}\n  .fitme-modal__link{display:inline-block;margin-top:6px;font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--fm-ink)}\n  .fitme-sztbl{width:100%;border-collapse:collapse;font-size:13px;margin-top:4px}\n  .fitme-sztbl th,.fitme-sztbl td{border:1px solid var(--fm-line);padding:8px 10px;text-align:center}\n  .fitme-sztbl th{background:var(--fm-card);font-weight:700;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--fm-ink)}\n  .fitme-sztbl td{color:#3a3a3a}\n  .fm-sftabs{display:flex;gap:6px;margin-bottom:16px;border-bottom:1px solid var(--fm-line)}\n  .fm-sftab{background:none;border:0;border-bottom:2px solid transparent;padding:8px 0;margin-right:18px;font:inherit;font-size:13px;font-weight:700;letter-spacing:.04em;color:var(--fm-mut);cursor:pointer;margin-bottom:-1px}\n  .fm-sftab.is-active{color:var(--fm-ink);border-bottom-color:var(--fm-ink)}\n  .fm-sf__lead{font-size:13px;color:var(--fm-mut);margin:0 0 14px}\n  .fm-sf__row{display:flex;gap:12px;margin:12px 0}\n  .fm-sf__row label{flex:1;font-size:13px;font-weight:600;color:var(--fm-ink);display:block}\n  .fm-sf__row label span{font-weight:400;color:var(--fm-mut)}\n  .fm-sf__row input{width:100%;box-sizing:border-box;margin-top:6px;border:1.5px solid #ddd;border-radius:10px;padding:12px;font:inherit;font-size:14px}\n  .fm-sf__btn{width:100%;background:#111;color:#fff;border:0;padding:14px;border-radius:10px;font-weight:700;letter-spacing:.04em;cursor:pointer;margin-top:6px}\n  .fm-sf__res{display:block;text-align:center;background:#fff;border:1px solid #ececec;border-radius:16px;padding:22px;box-shadow:0 6px 24px rgba(0,0,0,.05);margin-top:16px}\n  .fmsf-r__eyebrow{font-size:11px;font-weight:700;letter-spacing:1.5px;color:#9a9a9a;text-transform:uppercase}\n  .fmsf-r__size{font-size:44px;font-weight:800;letter-spacing:-1px;line-height:1.05;margin:4px 0 8px;color:#111}\n  .fmsf-r__sub{font-size:13px;color:#555;line-height:1.55}\n  .fmsf-r__hr{height:1px;background:#f0f0f0;margin:14px 0 0}\n  .fmsf-r__note{font-size:12px;color:#9a9a9a;margin-top:12px;line-height:1.5}\n  .fm-sf__err{color:#c0392b;font-weight:600}\n</style>\n\n{%- liquid\n  assign fit = product.metafields.custom.fit\n  assign model = product.metafields.custom.model\n  assign comp = product.metafields.custom.compression\n  assign speclabel = product.metafields.custom.spec_label | default: 'Compression'\n  assign lvl = product.metafields.custom.compression_level | default: 0 | plus: 0\n  assign bens = product.metafields.custom.benefits.value\n  assign sizetable = product.metafields.custom.size_table.value\n\n  assign has_card = false\n  if fit != blank or model != blank or comp != blank\n    assign has_card = true\n  endif\n\n  assign body_label = 'Vòng mông (cm)'\n  assign body_placeholder = 'VD: 92'\n  assign sizetable_lower = sizetable | downcase\n  if sizetable_lower contains 'vòng 1' or sizetable_lower contains 'ngực' or sizetable_lower contains 'v1'\n    assign body_label = 'Vòng ngực (cm)'\n    assign body_placeholder = 'VD: 85'\n  elsif sizetable_lower contains 'vòng eo' or sizetable_lower contains 'v2' or sizetable_lower contains 'eo'\n    assign body_label = 'Vòng eo (cm)'\n    assign body_placeholder = 'VD: 66'\n  endif\n-%}\n<div class=\"fitme-pdp\">\n  {%- if has_card -%}\n  <div class=\"fitme-fitcard\">\n    {%- if fit != blank -%}\n    <div class=\"fitme-fitrow\"><span class=\"fitme-lbl\">Fit</span><span class=\"fitme-val\">{{ fit }}</span></div>\n    {%- endif -%}\n    {%- if model != blank -%}\n    <div class=\"fitme-fitrow\"><span class=\"fitme-lbl\">Model</span><span class=\"fitme-val\">{{ model }}</span></div>\n    {%- endif -%}\n    {%- if comp != blank -%}\n    <div class=\"fitme-fitrow\">\n      <span class=\"fitme-lbl\">{{ speclabel }}</span>\n      <span class=\"fitme-val fitme-comp\">{{ comp }}\n        {%- if lvl > 0 -%}\n        <span class=\"fitme-dots\">\n          {%- for i in (1..3) -%}<span class=\"fitme-dot{% if i <= lvl %} on{% endif %}\"></span>{%- endfor -%}\n        </span>\n        {%- endif -%}\n      </span>\n    </div>\n    {%- endif -%}\n    {%- if sizetable != blank -%}\n    <div class=\"fitme-hint\">\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#b8894a\" stroke-width=\"1.6\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v5M12 8h.01\" stroke-linecap=\"round\"/></svg>\n      Chọn size thường mặc của bạn\n    </div>\n    <button type=\"button\" class=\"fitme-sizebtn\" onclick=\"this.closest('.fitme-pdp').querySelector('.fitme-modal').showModal()\">Tìm size của bạn →</button>\n    {%- endif -%}\n  </div>\n  {%- endif -%}\n\n  {%- if bens -%}\n  <div class=\"fitme-pills\">\n    {%- for b in bens -%}<span class=\"fitme-pill\">{{ b }}</span>{%- endfor -%}\n  </div>\n  {%- endif -%}\n\n  {%- if sizetable != blank -%}\n  <dialog class=\"fitme-modal\">\n    <div class=\"fitme-modal__hd\">\n      <h3>Tìm size của bạn</h3>\n      <button type=\"button\" class=\"fitme-modal__x\" onclick=\"this.closest('.fitme-modal').close()\">&times;</button>\n    </div>\n    <div class=\"fitme-modal__bd\">\n      <div class=\"fm-sftabs\">\n        <button type=\"button\" class=\"fm-sftab is-active\" data-fmtab=\"finder\" onclick=\"fmSfTab(this,'finder')\">Tìm size của bạn</button>\n        <button type=\"button\" class=\"fm-sftab\" data-fmtab=\"table\" onclick=\"fmSfTab(this,'table')\">Bảng size</button>\n      </div>\n      <div class=\"fm-sfpane\" data-fmpane=\"finder\">\n        <div class=\"fm-sizefinder\">\n          <p class=\"fm-sf__lead\">Nhập <b>chiều cao</b> và <b>cân nặng</b> để nhận size gợi ý. Có {{ body_label | downcase }} thì càng chuẩn.</p>\n          <div class=\"fm-sf__row\">\n            <label>Chiều cao (cm)*<input id=\"fmsf-h\" type=\"number\" inputmode=\"numeric\" placeholder=\"VD: 158\"></label>\n            <label>Cân nặng (kg)*<input id=\"fmsf-w\" type=\"number\" inputmode=\"numeric\" placeholder=\"VD: 52\"></label>\n          </div>\n          <div class=\"fm-sf__row\">\n            <label>{{ body_label }} <span>tùy chọn</span><input id=\"fmsf-hip\" type=\"number\" inputmode=\"numeric\" placeholder=\"{{ body_placeholder }}\"></label>\n          </div>\n          <button type=\"button\" id=\"fmsf-go\" class=\"fm-sf__btn\">GỢI Ý SIZE CHO TÔI</button>\n          <div id=\"fmsf-res\" class=\"fm-sf__res\" hidden></div>\n        </div>\n      </div>\n      <div class=\"fm-sfpane\" data-fmpane=\"table\" hidden>\n      <p>Chọn theo size bạn thường mặc. Nếu ở giữa 2 size, ưu tiên tăng 1 size để thoải mái vận động. Cần tư vấn thêm, nhắn shop để được hỗ trợ chọn size chuẩn nhất.</p>\n      {%- assign fm_rows = sizetable | strip | newline_to_br | split: '<br />' -%}\n      <table id=\"fmsf-table\" class=\"fitme-sztbl\">\n        {%- for fm_row in fm_rows -%}\n          {%- assign fm_cells = fm_row | split: '|' -%}\n          <tr>\n            {%- for fm_cell in fm_cells -%}\n              {%- if forloop.parentloop.first -%}<th>{{ fm_cell | strip }}</th>{%- else -%}<td>{{ fm_cell | strip }}</td>{%- endif -%}\n            {%- endfor -%}\n          </tr>\n        {%- endfor -%}\n      </table>\n      </div>\n    </div>\n    <script>(function(){\n  function toRange(s){ s=(s||'').replace(/kg|cm|\\s/gi,''); var m=s.match(/(\\d+)\\D+(\\d+)/); return m?[+m[1],+m[2]]:null; }\n  function toCeil(s){ var m=(s||'').match(/(\\d+)/); return m?+m[1]:null; }\n  function toH(s){ s=(s||'').replace(/cm/gi,''); var m=s.match(/(\\d)m(\\d{2}).*?(\\d)m(\\d{2})/);\n    if(m) return [(+m[1])*100+(+m[2]), (+m[3])*100+(+m[4])];\n    var n=s.match(/(\\d+)\\D+(\\d+)/); return n?[+n[1],+n[2]]:null; }\n  function readTable(){\n    var tbl=document.querySelector('#fmsf-table') || document.querySelector('.fitme-sztbl');\n    if(!tbl) return null;\n    var head=[].map.call(tbl.querySelectorAll('thead th, tr:first-child th, tr:first-child td'),function(c){return c.textContent.trim().toLowerCase();});\n    var iW=head.findIndex(function(h){return h.indexOf('cân nặng')>-1||h.indexOf('nặng')>-1});\n    var iHip=head.findIndex(function(h){return h.indexOf('mông')>-1||h.indexOf('v1')>-1||h.indexOf('v2')>-1||h.indexOf('v3')>-1||h.indexOf('ngực')>-1||h.indexOf('eo')>-1});\n    var iH=head.findIndex(function(h){return h.indexOf('cao')>-1});\n    var iS=head.findIndex(function(h){return h.indexOf('size')>-1}); if(iS<0)iS=0;\n    var rows=[].filter.call(tbl.querySelectorAll('tbody tr'),function(r){return r.querySelectorAll('td').length});\n    if(!rows.length) rows=[].slice.call(tbl.querySelectorAll('tr')).slice(1);\n    return rows.map(function(r){var c=r.querySelectorAll('td,th');return {\n      size:(c[iS]||c[0]).textContent.trim(),\n      w:toRange((c[iW]||{}).textContent), hip:toCeil((c[iHip]||{}).textContent), h:toH((c[iH]||{}).textContent)\n    };}).filter(function(x){return x.size});\n  }\n  function recommend(rows,h,w,hip){\n    var idx=-1;\n    for(var i=0;i<rows.length;i++){var r=rows[i].w; if(r&&w>=r[0]&&w<=r[1]) idx=i;}\n    if(idx<0){ var f=rows[0].w,l=rows[rows.length-1].w;\n      if(f&&w<f[0])idx=0; else if(l&&w>l[1])idx=rows.length-1;\n      else{for(var j=0;j<rows.length;j++){if(rows[j].w&&rows[j].w[0]>w){idx=j;break;}} if(idx<0)idx=rows.length-1;} }\n    if(hip){ var base=idx; while(idx<rows.length-1 && idx<base+1 && rows[idx].hip && hip>=rows[idx].hip) idx++; }\n    var note=''; var hr=rows[idx].h;\n    if(h&&hr){ if(h>hr[1]&&idx<rows.length-1) note='Bạn cao hơn mức TB của size này — thích ống dài trọn thì cân nhắc '+rows[idx+1].size+'.';\n      else if(h<hr[0]&&idx>0) note='Bạn thấp hơn mức TB — thích ôm gọn thì cân nhắc '+rows[idx-1].size+'.'; }\n    return {size:rows[idx].size, note:note};\n  }\n  window.fmSfTab=function(btn,name){\n    var root=btn.closest('.fitme-modal__bd'); if(!root) return;\n    [].forEach.call(root.querySelectorAll('.fm-sftab'),function(b){b.classList.toggle('is-active',b.getAttribute('data-fmtab')===name);});\n    [].forEach.call(root.querySelectorAll('.fm-sfpane'),function(p){p.hidden=p.getAttribute('data-fmpane')!==name;});\n  };\n  window.fmSizeFinderInit=function(){\n    var go=document.getElementById('fmsf-go'); if(!go||go._bound) return; go._bound=true;\n    go.addEventListener('click',function(){\n      var rows=readTable(); if(!rows||!rows.length) return;\n      var h=parseFloat(document.getElementById('fmsf-h').value);\n      var w=parseFloat(document.getElementById('fmsf-w').value);\n      var hip=parseFloat(document.getElementById('fmsf-hip').value);\n      var res=document.getElementById('fmsf-res');\n      if(!w||!h){ res.hidden=false; res.innerHTML='<span class=\"fm-sf__err\">Vui lòng nhập chiều cao và cân nặng.</span>'; return; }\n      var r=recommend(rows,h,w,hip||0);\n      res.hidden=false;\n      res.innerHTML='<div class=\"fmsf-r__eyebrow\">Size gợi ý cho bạn</div>'\n        +'<div class=\"fmsf-r__size\">'+r.size+'</div>'\n        +'<div class=\"fmsf-r__sub\">'+(r.note?r.note:'Dựa trên số đo bạn vừa nhập.')+'</div>'\n        +'<div class=\"fmsf-r__hr\"></div>'\n        +'<div class=\"fmsf-r__note\">Bảng để mặc ôm như mẫu — muốn thoải mái hơn có thể tăng 1 size.</div>';\n    });\n  };\n  if(document.getElementById('fmsf-go')) window.fmSizeFinderInit();\n})();</script>\n  </dialog>\n  {%- endif -%}\n</div>\n{%- endif -%}"
          }
