<style>
  /* ===== SHOPEE REDIRECT — FITME ===== */
  .fm-redirect, .fm-redirect * { box-sizing: border-box; }
  .fm-redirect { color: #2d3748; }

  .fm-wrap { padding: 40px 18px 48px; }
  .fm-card {
    background: #fff;
    border: 1px solid #eef0f3;
    border-radius: 22px;
    box-shadow: 0 10px 40px rgba(22, 36, 61, 0.08);
    padding: 40px 26px 34px;
    max-width: 460px;
    margin: 0 auto;
    text-align: center;
  }
  .fm-card-head { color: #8a94a6; font-size: 15px; margin-bottom: 6px; }
  .fm-card-title { font-size: 19px; color: #2d3748; margin-bottom: 28px; line-height: 1.45; }
  .fm-card-title b { color: #16243d; font-weight: 800; }

  .fm-btn {
    display: flex; align-items: center; justify-content: center; gap: 11px;
    width: 100%; background: #ee4d2d; color: #fff; font-size: 18px; font-weight: 700;
    border: none; border-radius: 13px; padding: 17px; text-decoration: none; cursor: pointer;
    box-shadow: 0 8px 20px rgba(238, 77, 45, 0.32);
    transition: transform .12s ease, box-shadow .12s ease;
  }
  .fm-btn:hover { transform: translateY(-1px); box-shadow: 0 10px 26px rgba(238, 77, 45, 0.4); }
  .fm-btn:active { transform: translateY(0); }
  .fm-btn img { width: 26px; height: 26px; flex-shrink: 0; display: block; }

  .fm-pill {
    margin: 16px auto 0; display: inline-flex; align-items: center; gap: 8px;
    background: #f1f3f6; color: #6b7585; font-size: 13px; padding: 9px 18px; border-radius: 999px;
  }

  .fm-backup-note {
    margin-top: 26px; text-align: left;
    font-size: 13.5px; color: #6b7585; line-height: 1.5;
  }
  .fm-backup-note b { color: #2d3748; }

  .fm-steps { margin-top: 16px; text-align: left; }
  .fm-step { margin-bottom: 22px; }
  .fm-step:last-child { margin-bottom: 0; }
  .fm-step-label {
    display: flex; align-items: center; gap: 9px;
    font-size: 14px; font-weight: 700; color: #16243d; margin-bottom: 10px;
  }
  .fm-step-num {
    width: 24px; height: 24px; background: #ee4d2d; color: #fff; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 800; flex-shrink: 0;
  }
  .fm-step img {
    width: 100%; display: block; border-radius: 14px;
    border: 1px solid #e7eaef; box-shadow: 0 4px 16px rgba(22,36,61,.07);
  }

  .fm-card-foot { margin-top: 22px; color: #b3bac6; font-size: 13px; text-align: center; }

  @media (min-width: 640px) { .fm-card { padding: 48px 40px 40px; } }
</style>

<div class="fm-redirect">
  <div class="fm-wrap">
    <div class="fm-card">
      <div class="fm-card-head">Bạn đang được chuyển đến</div>
      <div class="fm-card-title"><b>Shop Chính Hãng Fitme</b> trên Shopee</div>

      <a class="fm-btn" href="https://s.shopee.vn/3g02SBZrAh" target="_blank" rel="noopener">
        <img src="https://cdn.shopify.com/s/files/1/0828/7676/0373/files/shopee-bag-white.png?v=1781145909" alt="Shopee">
        Mở Shopee ngay
      </a>

      <div class="fm-pill">🔒 Shop chính hãng · Ưu đãi độc quyền</div>

      <div class="fm-backup-note">
        Nếu trang <b>không tự chuyển sang Shopee</b>, làm theo 2 bước sau:
      </div>

      <div class="fm-steps">
        <div class="fm-step">
          <div class="fm-step-label"><span class="fm-step-num">1</span> Bấm dấu ••• ở góc phải trên cùng</div>
          <img src="https://cdn.shopify.com/s/files/1/0828/7676/0373/files/huong-dan-buoc-1.jpg?v=1781143851" alt="Bước 1: bấm dấu ba chấm góc phải trên cùng" loading="lazy">
        </div>
        <div class="fm-step">
          <div class="fm-step-label"><span class="fm-step-num">2</span> Chọn "Mở trong trình duyệt"</div>
          <img src="https://cdn.shopify.com/s/files/1/0828/7676/0373/files/huong-dan-buoc-2.jpg?v=1781143851" alt="Bước 2: chọn Mở trong trình duyệt" loading="lazy">
        </div>
      </div>

      <div class="fm-card-foot">fitme.vn</div>
    </div>
  </div>
</div>
