{% schema %}
{
  "name": "Grid Hình Ảnh",
  "class": "grid-hinh-anh-section",
  "settings": [
    {
      "type": "header",
      "content": "Thiết lập chung"
    },
    {
      "type": "range",
      "id": "section_width",
      "label": "Độ rộng section (%)",
      "min": 50,
      "max": 100,
      "step": 1,
      "default": 100
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Màu nền section",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Khoảng cách đệm section (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Khoảng cách giữa các hình (px)",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 20
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Số cột trên desktop",
      "options": [
        { "value": "2", "label": "2 cột" },
        { "value": "3", "label": "3 cột" },
        { "value": "4", "label": "4 cột" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_tablet",
      "label": "Số cột trên tablet",
      "options": [
        { "value": "2", "label": "2 cột" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Số cột trên mobile",
      "options": [
        { "value": "1", "label": "1 cột" },
        { "value": "2", "label": "2 cột" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Hiệu ứng & Phong cách"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Bo góc hình ảnh (px)",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 0
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Tỷ lệ khung hình",
      "options": [
        { "value": "auto", "label": "Tự nhiên" },
        { "value": "1_1", "label": "Vuông 1:1" },
        { "value": "4_3", "label": "Ngang 4:3" },
        { "value": "3_4", "label": "Dọc 3:4" },
        { "value": "16_9", "label": "Ngang 16:9" },
        { "value": "9_16", "label": "Dọc 9:16" }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "object_fit",
      "label": "Kiểu hiển thị hình",
      "options": [
        { "value": "cover", "label": "Phủ toàn bộ" },
        { "value": "contain", "label": "Vừa khung" },
        { "value": "fill", "label": "Kéo giãn" }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "hover_scale",
      "label": "Tỷ lệ phóng to khi hover (%)",
      "min": 100,
      "max": 120,
      "step": 1,
      "default": 105
    }
  ],
  "max_blocks": 20,
  "blocks": [
    {
      "type": "image",
      "name": "Hình ảnh",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Hình ảnh"
        },
        {
          "type": "url",
          "id": "image_link",
          "label": "Liên kết (tùy chọn)"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Mô tả hình ảnh (alt)",
          "default": "Mô tả hình ảnh",
          "info": "Tốt cho SEO và trải nghiệm người dùng"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grid Hình Ảnh",
      "category": "Hình ảnh",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}

<div class="grid-hinh-anh-section" 
     style="max-width: {{ section.settings.section_width }}%; 
            margin: 0 auto; 
            background-color: {{ section.settings.section_bg }};
            padding: {{ section.settings.section_padding }}px 0;">
  
  <div class="image-grid-container"
       style="gap: {{ section.settings.gap }}px;
              --desktop-columns: {{ section.settings.columns_desktop }};
              --tablet-columns: {{ section.settings.columns_tablet }};
              --mobile-columns: {{ section.settings.columns_mobile }};
              --image-ratio: {% if section.settings.image_ratio == '1_1' %}100%{% elsif section.settings.image_ratio == '4_3' %}75%{% elsif section.settings.image_ratio == '3_4' %}133.33%{% elsif section.settings.image_ratio == '16_9' %}56.25%{% elsif section.settings.image_ratio == '9_16' %}177.78%{% else %}auto{% endif %};
              --hover-scale: {{ section.settings.hover_scale | divided_by: 100.0 }};">
    
    {% for block in section.blocks %}
      {% if block.settings.image %}
        <div class="grid-image-item" {{ block.shopify_attributes }}>
          {% if block.settings.image_link != blank %}
            <a href="{{ block.settings.image_link }}" class="grid-image-link">
          {% endif %}
          
          <div class="grid-image-wrapper" 
               style="border-radius: {{ section.settings.image_radius }}px; 
                      {% if section.settings.image_ratio != 'auto' %}padding-bottom: var(--image-ratio);{% endif %}">
            
            <img src="{{ block.settings.image | img_url: 'master' }}" 
                 alt="{{ block.settings.image_alt | escape }}"
                 loading="lazy"
                 class="grid-image"
                 style="object-fit: {{ section.settings.object_fit }};">
          </div>
          
          {% if block.settings.image_link != blank %}
            </a>
          {% endif %}
        </div>
      {% else %}
        <div class="grid-image-item placeholder" {{ block.shopify_attributes }}>
          <div class="grid-image-wrapper placeholder-wrapper" 
               style="border-radius: {{ section.settings.image_radius }}px; 
                      {% if section.settings.image_ratio != 'auto' %}padding-bottom: var(--image-ratio);{% endif %}">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<style>
  .grid-hinh-anh-section {
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }
  
  .image-grid-container {
    display: grid;
    grid-template-columns: repeat(var(--desktop-columns), 1fr);
    gap: inherit;
    width: 100%;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }
  
  .grid-image-item {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  
  .grid-image-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    height: auto;
  }
  
  .grid-image-wrapper[style*="padding-bottom"] {
    height: 0;
  }
  
  .grid-image {
    width: 100%;
    height: 100%;
    display: block;
    transition: transform 0.4s ease;
  }
  
  .grid-image-wrapper[style*="padding-bottom"] .grid-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  
  .grid-image-link {
    display: block;
    width: 100%;
    height: 100%;
  }
  
  .grid-image-link:hover .grid-image {
    transform: scale(var(--hover-scale));
  }
  
  .placeholder-wrapper {
    background-color: #f6f6f6;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 200px;
  }
  
  .placeholder-svg {
    width: 50%;
    height: 50%;
    opacity: 0.5;
  }
  
  /* Tablet Styles */
  @media screen and (max-width: 1024px) {
    .image-grid-container {
      grid-template-columns: repeat(var(--tablet-columns), 1fr);
    }
  }
  
  /* Mobile Styles */
  @media screen and (max-width: 749px) {
    .image-grid-container {
      grid-template-columns: repeat(var(--mobile-columns), 1fr);
      padding: 0 10px;
      gap: calc(var(--gap) * 0.8);
    }
  }
</style>