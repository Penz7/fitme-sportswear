{% schema %}
{
  "name": "Image Grid Collection",
  "tag": "section",
  "class": "image-grid-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Tiêu đề chính",
      "default": "Play with ace in your veins."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Phụ đề chính",
      "default": "Leylah Fernandez and Frances Tiafoe were born for this. And they're dressed for this."
    },
    {
      "type": "header",
      "content": "Kích thước và khoảng cách"
    },
    {
      "type": "range",
      "id": "section_max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Chiều rộng tối đa của section",
      "default": 1200
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding trên",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding dưới",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding ngang",
      "default": 20
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Khoảng cách giữa các ảnh",
      "default": 20
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Căn lề văn bản chính",
      "options": [
        {
          "value": "text-left",
          "label": "Trái"
        },
        {
          "value": "text-center",
          "label": "Giữa"
        },
        {
          "value": "text-right",
          "label": "Phải"
        }
      ],
      "default": "text-center"
    },
    {
      "type": "header",
      "content": "Màu sắc"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Màu nền",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Màu tiêu đề chính",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Màu phụ đề chính",
      "default": "#555555"
    },
    {
      "type": "header",
      "content": "Tùy chọn hình ảnh"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Bo góc hình ảnh",
      "default": 0
    },
    {
      "type": "header",
      "content": "Tùy chọn nút"
    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Bo góc nút",
      "default": 0
    },
    {
      "type": "range",
      "id": "button_padding_x",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Padding ngang nút",
      "default": 20
    },
    {
      "type": "range",
      "id": "button_padding_y",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "label": "Padding dọc nút",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "image_block",
      "name": "Khối hình ảnh",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Hình ảnh"
        },
        {
          "type": "select",
          "id": "image_ratio",
          "label": "Tỷ lệ hình ảnh",
          "options": [
            {
              "value": "aspect-[16/9]",
              "label": "16:9 (Ngang)"
            },
            {
              "value": "aspect-[4/3]",
              "label": "4:3 (Ngang)"
            },
            {
              "value": "aspect-square",
              "label": "1:1 (Vuông)"
            },
            {
              "value": "aspect-[4/5]",
              "label": "4:5 (Dọc)"
            },
            {
              "value": "aspect-[9/16]",
              "label": "9:16 (Dọc)"
            },
            {
              "value": "aspect-auto",
              "label": "Tự động (kích thước gốc)"
            }
          ],
          "default": "aspect-auto"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Tiêu đề",
          "default": "Play like your fire is your fuel."
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Phụ đề",
          "default": "Leylah Fernandez brings the heat—her tournament looks are the spark."
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Màu tiêu đề",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "subheading_color",
          "label": "Màu phụ đề",
          "default": "#555555"
        },
        {
          "type": "header",
          "content": "Nút 1"
        },
        {
          "type": "text",
          "id": "button1_text",
          "label": "Nội dung nút 1",
          "default": "SHOP WOMEN'S TENNIS"
        },
        {
          "type": "url",
          "id": "button1_link",
          "label": "Liên kết nút 1"
        },
        {
          "type": "color",
          "id": "button1_bg_color",
          "label": "Màu nền nút 1",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "button1_text_color",
          "label": "Màu chữ nút 1",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "button1_border_color",
          "label": "Màu viền nút 1",
          "default": "#000000"
        },
        {
          "type": "header",
          "content": "Nút 2"
        },
        {
          "type": "text",
          "id": "button2_text",
          "label": "Nội dung nút 2",
          "default": "SHOP SHORTS"
        },
        {
          "type": "url",
          "id": "button2_link",
          "label": "Liên kết nút 2"
        },
        {
          "type": "color",
          "id": "button2_bg_color",
          "label": "Màu nền nút 2",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "button2_text_color",
          "label": "Màu chữ nút 2",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "button2_border_color",
          "label": "Màu viền nút 2",
          "default": "#000000"
        },
        {
          "type": "checkbox",
          "id": "hide_button2",
          "label": "Ẩn nút 2",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Grid Collection",
      "blocks": [
        {
          "type": "image_block",
          "settings": {
            "heading": "Play like your fire is your fuel.",
            "subheading": "Leylah Fernandez brings the heat—her tournament looks are the spark.",
            "button1_text": "SHOP WOMEN'S TENNIS",
            "button2_text": "SHOP SHORTS"
          }
        },
        {
          "type": "image_block",
          "settings": {
            "heading": "Play like dreams are destined.",
            "subheading": "Get into Big Foe's signature tournament fits—then go bigger.",
            "button1_text": "SHOP MEN'S TENNIS",
            "button2_text": "SHOP SHORTS"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  .image-grid-section {
    width: 100%;
  }
  
  .image-grid-container {
    margin: 0 auto;
  }
  
  .image-block-btn {
    display: inline-block;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    margin-right: 10px;
    margin-bottom: 10px;
    border-width: 1px;
    border-style: solid;
  }
  
  .image-block-btn:hover {
    opacity: 0.85;
  }
  
  .image-wrapper {
    position: relative;
    overflow: hidden;
  }
  
  .image-block-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  
  .image-block h3 {
    font-size: 24px;
    font-weight: 700;
    margin-top: 20px;
    margin-bottom: 8px;
    line-height: 1.2;
  }
  
  .image-block .subheading {
    font-size: 15px;
    line-height: 1.4;
    margin-bottom: 20px;
  }
  
  .image-grid {
    display: flex;
    flex-wrap: wrap;
  }
  
  .image-block {
    flex: 1 1 calc(50% - 10px);
    min-width: 0;
  }
  
  @media (max-width: 767px) {
    .image-grid {
      flex-direction: column;
    }
    
    .image-block {
      flex: 1 1 100%;
      margin-bottom: 30px;
    }
    
    .image-block:last-child {
      margin-bottom: 0;
    }
    
    .image-block h3 {
      font-size: 20px;
    }
    
    .image-block .subheading {
      font-size: 14px;
    }
    
    .image-block-btn {
      font-size: 12px;
    }
  }
</style>

<section class="image-grid-section" 
         style="background-color: {{ section.settings.bg_color }}; 
                padding-top: {{ section.settings.section_padding_top }}px; 
                padding-bottom: {{ section.settings.section_padding_bottom }}px;">
  <div class="image-grid-container" style="max-width: {{ section.settings.section_max_width }}px; 
                                          padding-left: {{ section.settings.section_padding_horizontal }}px; 
                                          padding-right: {{ section.settings.section_padding_horizontal }}px;">
    
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="section-header mb-8 md:mb-12 {{ section.settings.text_align }}">
        {% if section.settings.heading != blank %}
          <h2 class="text-3xl md:text-4xl font-bold mb-3" style="color: {{ section.settings.heading_color }};">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
        
        {% if section.settings.subheading != blank %}
          <div class="text-base max-w-3xl mx-auto" style="color: {{ section.settings.subheading_color }};">
            {{ section.settings.subheading }}
          </div>
        {% endif %}
      </div>
    {% endif %}
    
    <div class="image-grid" style="gap: {{ section.settings.grid_gap }}px;">
      {% for block in section.blocks %}
        {% if block.type == 'image_block' %}
          <div class="image-block" {{ block.shopify_attributes }}>
            <div class="image-wrapper" style="border-radius: {{ section.settings.image_radius }}px;">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | img_url: 'master' }}" 
                     alt="{{ block.settings.heading | escape }}"
                     loading="lazy"
                     class="image-block-image {{ block.settings.image_ratio }}"
                     style="border-radius: {{ section.settings.image_radius }}px;">
              {% else %}
                <div class="w-full bg-gray-200 {{ block.settings.image_ratio }}" style="min-height: 300px;">
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                </div>
              {% endif %}
            </div>
            
            <div class="image-content mt-5">
              {% if block.settings.heading != blank %}
                <h3 style="color: {{ block.settings.heading_color }};">
                  {{ block.settings.heading }}
                </h3>
              {% endif %}
              
              {% if block.settings.subheading != blank %}
                <div class="subheading" style="color: {{ block.settings.subheading_color }};">
                  {{ block.settings.subheading }}
                </div>
              {% endif %}
              
              <div class="image-block-buttons mt-4">
                {% if block.settings.button1_text != blank %}
                  <a href="{{ block.settings.button1_link }}" 
                     class="image-block-btn"
                     style="background-color: {{ block.settings.button1_bg_color }}; 
                            color: {{ block.settings.button1_text_color }}; 
                            border-color: {{ block.settings.button1_border_color }};
                            border-radius: {{ section.settings.button_radius }}px;
                            padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;">
                    {{ block.settings.button1_text }}
                  </a>
                {% endif %}
                
                {% if block.settings.button2_text != blank and block.settings.hide_button2 == false %}
                  <a href="{{ block.settings.button2_link }}" 
                     class="image-block-btn"
                     style="background-color: {{ block.settings.button2_bg_color }}; 
                            color: {{ block.settings.button2_text_color }}; 
                            border-color: {{ block.settings.button2_border_color }};
                            border-radius: {{ section.settings.button_radius }}px;
                            padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;">
                    {{ block.settings.button2_text }}
                  </a>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>