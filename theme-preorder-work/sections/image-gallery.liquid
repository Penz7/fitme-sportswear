{% comment %}
============================================================================
  Section: Flexible Content (Version 3.3 - Final Stable Base)
  - Fixed schema 'step' error.
  - This version is a stable, non-slider base for future development.
============================================================================
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .page-width-{{ section.id }} {
    max-width: {{ section.settings.section_max_width }}%;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  
  /* --- Text Block Styles --- */
  .fcb__text-block {
    text-align: {{ section.settings.text_align }};
    margin-bottom: 25px;
  }
  .fcb__heading {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    margin: 0 0 10px 0;
    word-break: break-word;
  }
  .fcb__paragraph {
    color: {{ section.settings.paragraph_color }};
    font-size: {{ section.settings.paragraph_size }}px;
    margin: 0;
    word-break: break-word;
  }

  /* --- Gallery Grid Styles --- */
  .fcb__gallery-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.grid_row_gap }}px {{ section.settings.grid_column_gap }}px;
  }
  .fcb__gallery-item-link {
    display: block;
    text-decoration: none;
    line-height: 0;
    position: relative;
    overflow: hidden;
  }
  .fcb__gallery-item-image {
    width: 100%;
    height: auto;
    transition: transform 0.4s ease;
  }
  .fcb__gallery-item-link:hover .fcb__gallery-item-image {
    transform: scale(1.05);
  }

  /* --- Responsive --- */
  @media screen and (max-width: 768px) {
    .fcb__heading { font-size: {{ section.settings.heading_size | times: 0.8 | round: 0 }}px; }
    .fcb__paragraph { font-size: {{ section.settings.paragraph_size | times: 0.8 | round: 0 }}px; }
    .fcb__gallery-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      gap: {{ section.settings.grid_column_gap | divided_by: 1.5 | round: 0 }}px;
    }
  }
</style>

<div class="shopify-section">
  <div class="page-width-{{ section.id }}">
    
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        {%- case block.type -%}
          
          {%- when 'heading' -%}
            <div class="fcb__text-block">
              <h2 class="fcb__heading">{{ block.settings.text | escape }}</h2>
            </div>

          {%- when 'paragraph' -%}
            <div class="fcb__text-block">
              <div class="fcb__paragraph">{{ block.settings.text }}</div>
            </div>

          {%- when 'image_grid' -%}
            <div class="fcb__gallery-grid">
              {%- for i in (1..12) -%}
                {%- liquid
                  assign image_setting = 'image_' | append: i
                  assign link_setting = 'link_' | append: i
                  assign radius_setting = 'radius_' | append: i
                  
                  assign image = block.settings[image_setting]
                  assign link = block.settings[link_setting]
                  assign radius = block.settings[radius_setting]
                -%}
                {%- if image != blank -%}
                  <div class="fcb__gallery-item">
                    <a {% if link != blank %}href="{{ link }}"{% endif %} class="fcb__gallery-item-link" style="border-radius: {{ radius }}px;">
                      <img class="fcb__gallery-item-image"
                           src="{{ image | image_url: width: 500 }}"
                           srcset="{{ image | image_url: width: 300 }} 300w,
                                   {{ image | image_url: width: 500 }} 500w,
                                   {{ image | image_url: width: 800 }} 800w"
                           sizes="(max-width: 768px) calc(100vw / {{ section.settings.columns_mobile }}), calc(100vw / {{ section.settings.columns_desktop }})"
                           loading="lazy"
                           width="{{ image.width }}"
                           height="{{ image.height }}"
                           alt="{{ image.alt | escape }}">
                    </a>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
</div>

