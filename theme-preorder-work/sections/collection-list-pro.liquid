    {
      "type": "checkbox",
      "id": "stack_collections",
      "label": "Stack collections",
      "default": false
    },
    {
      "type": "select",
      "id": "collections_per_row_mobile",
      "label": "Collections per row (mobile - stacked)",
      "options": [
        {
          "value": "1",
